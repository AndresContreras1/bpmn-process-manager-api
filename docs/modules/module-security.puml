@startuml
title <size:24>Security</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Component>

System_Boundary("ProcesosApplication_boundary", "ProcesosApplication", $tags="") {
  Container_Boundary("ProcesosApplication.ProcesosApplication_boundary", "ProcesosApplication", $tags="") {
    Component(ProcesosApplication.ProcesosApplication.Common, "Common", $techn="Module", $descr="", $tags="", $link="")
    Component(ProcesosApplication.ProcesosApplication.Gestion, "Gestion", $techn="Module", $descr="", $tags="", $link="")
    Component(ProcesosApplication.ProcesosApplication.Security, "Security", $techn="Module", $descr="", $tags="", $link="")
  }

}

Rel(ProcesosApplication.ProcesosApplication.Security, ProcesosApplication.ProcesosApplication.Gestion, "listens to", $techn="", $tags="", $link="")
Rel(ProcesosApplication.ProcesosApplication.Security, ProcesosApplication.ProcesosApplication.Common, "uses", $techn="", $tags="", $link="")
Rel(ProcesosApplication.ProcesosApplication.Security, ProcesosApplication.ProcesosApplication.Gestion, "uses", $techn="", $tags="", $link="")
Rel(ProcesosApplication.ProcesosApplication.Gestion, ProcesosApplication.ProcesosApplication.Common, "uses", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml