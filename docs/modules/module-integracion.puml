    Component(ProcesosApplication.ProcesosApplication.Common, "Common", $techn="Module", $descr="", $tags="", $link="")
    Component(ProcesosApplication.ProcesosApplication.Modelado, "Modelado", $techn="Module", $descr="", $tags="", $link="")
    Component(ProcesosApplication.ProcesosApplication.Ejecucion, "Ejecucion", $techn="Module", $descr="", $tags="", $link="")
