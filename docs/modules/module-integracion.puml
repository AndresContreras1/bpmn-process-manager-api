}

Rel(ProcesosApplication.ProcesosApplication.Integracion, ProcesosApplication.ProcesosApplication.Modelado, "depends on", $techn="", $tags="", $link="")
Rel(ProcesosApplication.ProcesosApplication.Integracion, ProcesosApplication.ProcesosApplication.Common, "depends on", $techn="", $tags="", $link="")
