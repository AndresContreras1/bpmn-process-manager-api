{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false,
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "bpmn-process-manager-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/bpmn-process-manager-web",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js", "@angular/localize/init"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fortawesome/fontawesome-free/css/all.min.css",
              "src/styles.scss",
              { "input": "node_modules/bpmn-js/dist/assets/diagram-js.css", "bundleName": "bpmn", "inject": false },
              { "input": "node_modules/bpmn-js/dist/assets/bpmn-js.css", "bundleName": "bpmn", "inject": false },
              {
                "input": "node_modules/bpmn-js/dist/assets/bpmn-font/css/bpmn.css",
                "bundleName": "bpmn",
                "inject": false
              },
              {
                "input": "node_modules/diagram-js-minimap/assets/diagram-js-minimap.css",
                "bundleName": "bpmn",
                "inject": false
              },
              { "input": "src/app/bpmn/lienzo-bpmn.scss", "bundleName": "bpmn", "inject": false }
            ],
            "scripts": [],
            "stylePreprocessorOptions": {
              "sass": {
                "silenceDeprecations": ["import", "global-builtin", "color-functions", "if-function"]
              }
            },
            "i18nMissingTranslation": "error",
            "allowedCommonJsDependencies": ["qrcode"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "790kB",
                  "maximumError": "800kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "security": {
                "autoCsp": true
              },
              "localize": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "bpmn-process-manager-web:build:production"
            },
            "development": {
              "buildTarget": "bpmn-process-manager-web:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "bpmn-process-manager-web:build",
            "format": "json",
            "outputPath": "src/locale"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "buildTarget": "bpmn-process-manager-web:build:development"
          }
        }
      },
      "i18n": {
        "sourceLocale": {
          "code": "en-US",
          "subPath": "en-US"
        },
        "locales": {
          "en-AU": {
            "translation": "src/locale/messages.en-AU.json",
            "subPath": "en-AU"
          },
          "es-CO": {
            "translation": "src/locale/messages.es-CO.json",
            "subPath": "es-CO"
          },
          "fr-FR": {
            "translation": "src/locale/messages.fr-FR.json",
            "subPath": "fr-FR"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
