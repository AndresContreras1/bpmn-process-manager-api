# Copy this file to .env and fill it in. Docker Compose reads .env by itself; .env is not committed.
# The two values without a default stop `docker compose up` until they are set.

# Database. The user and the database are created on the first start, inside the named volume.
DB_NAME=procesos
DB_USER=procesos
DB_PASSWORD=

# HS256 signing key for the access tokens, at least 32 characters. The prod profile does not start without it.
JWT_SECRET=

# Origins allowed to call the API from a browser, separated by commas. A browser sends Origin on every POST, even
# when the app and the API share an origin through NGINX, and Spring answers 403 to one that is not on this list.
# Left empty, the stack allows the web app on WEB_PORT. Add http://localhost:4200 to also use the dev server.
CORS_ALLOWED_ORIGINS=

# Host port the API listens on. The web app does not use it: it reaches the API inside the network.
API_PORT=8080

# Host port the web app listens on. Open http://localhost:WEB_PORT to use the whole stack.
WEB_PORT=80

# What a published version says never changes, so the API keeps it in memory instead of reading and parsing it on
# every request. Set it to false to turn the cache off; the API answers exactly the same, only slower.
CACHE_VERSIONES=true
